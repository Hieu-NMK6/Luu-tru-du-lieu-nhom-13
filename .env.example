# Mẫu cấu hình. Chạy `make env` (scripts/gen_env.sh) để sinh .env với bí mật ngẫu nhiên.
# __RANDOM__ -> chuỗi 24 ký tự [A-Za-z0-9]; __KMS_KEY__ -> khóa 32 byte base64.
# Chỉ dùng ký tự chữ-số cho mật khẩu vì chúng được nhúng vào URL (postgresql://, MC_HOST_*).
TZ=Asia/Ho_Chi_Minh

# ---- Root MinIO (chỉ dùng cho quản trị: setup.sh) ----
MINIO_A_ROOT_USER=admin-a
MINIO_A_ROOT_PASSWORD=__RANDOM__
MINIO_B_ROOT_USER=admin-b
MINIO_B_ROOT_PASSWORD=__RANDOM__

# ---- SSE-S3: khóa KMS tĩnh "tên:base64(32 byte)", dùng CHUNG cho 2 site ----
MINIO_KMS_SECRET_KEY=minio-kms:__KMS_KEY__

# ---- PostgreSQL (user/database cố định: mlflow) ----
POSTGRES_A_PASSWORD=__RANDOM__
POSTGRES_B_PASSWORD=__RANDOM__

# ---- User ứng dụng trên MinIO (least privilege, KHÔNG dùng root) ----
MLFLOW_APP_ACCESS_KEY=mlflow-app          # đọc/ghi mlflow-artifacts
MLFLOW_APP_SECRET_KEY=__RANDOM__
RAW_READER_ACCESS_KEY=raw-reader          # chỉ đọc raw-data
RAW_READER_SECRET_KEY=__RANDOM__
INGEST_ACCESS_KEY=ingest-writer           # chỉ ghi raw-data (không xóa)
INGEST_SECRET_KEY=__RANDOM__
BACKUP_ACCESS_KEY=db-backup-writer        # chỉ ghi/đọc db-backup (không xóa)
BACKUP_SECRET_KEY=__RANDOM__

# ---- Endpoint cho app/ (đổi sang 5100 / 9100 khi failover sang site B) ----
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_S3_ENDPOINT_URL=http://localhost:9000
